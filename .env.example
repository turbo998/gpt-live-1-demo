# Advanced deployment settings. Most users can leave this file untouched and
# enter credentials in the browser setup wizard.
APP_MODE=local
HOST=127.0.0.1
PORT=8767
APP_DATA_DIR=

# Realtime voice service. The base URL is the service API root, without a key.
LIVE_PROVIDER=azure
# api-key (default), or managed-identity on an Azure host with resource-scoped RBAC.
LIVE_AUTH=api-key
LIVE_BASE_URL=
LIVE_API_KEY=
LIVE_MODEL=gpt-live-1

# Optional Responses-compatible reasoning service. Leave blank to configure it
# in the wizard or run without backend reasoning features.
REASONING_BASE_URL=
REASONING_API_KEY=
REASONING_MODEL=
REASONING_AUTH=bearer

# Required for a remote deployment. Use an HTTPS origin, including the scheme.
PUBLIC_ORIGIN=
# Required for first remote startup: at least 24 random characters.
# Never printed to application logs. Enter it privately on the setup page.
SETUP_TOKEN=
# Server-enforced ceiling, independent of saved browser preferences (1-30).
# When unset: remote=10, local=30. Does not impose a hard monetary spending cap.
# MAX_SESSION_MINUTES=10
